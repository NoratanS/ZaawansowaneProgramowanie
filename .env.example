# Copy to .env (gitignored), then run `uv run generate-keys` to fill the keys.
# Only compose reads this file; the apps read real env vars.

RABBITMQ_DEFAULT_USER=people-counter
RABBITMQ_DEFAULT_PASS=people-counter
POSTGRES_PASSWORD=people-counter
# RustFS credentials, for the photo store.
S3_ACCESS_KEY=people-counter
S3_SECRET_KEY=people-counter

ANALYSIS_API_PORT=8000
RESULTS_PORT=8001

LOG_LEVEL=INFO

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
